{
  "name": "poo-game",
  "version": "0.1.3",
  "private": true,
  "homepage": "https://munkacsimark.github.io/poo-game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "oxlint --type-aware && eslint .",
    "lint:fix": "oxlint --type-aware --fix && eslint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "changelog": "git-cliff --output CHANGELOG.md && oxfmt CHANGELOG.md",
    "release": "node scripts/release.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-oxlint": "^1.90.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "git-cliff": "^2.14.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-imagetools": "^12.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1"
}
